#!/usr/bin/env bash
#MISE description="Browse and open Jira issues in browser"
#MISE env={_.file=".env"}

set -euo pipefail

# Fetch issues from Jira
ISSUES=$(curl -s -X POST "https://$JIRA_HOST/rest/api/3/search/jql" \
  -H "Authorization: Basic $JIRA_AUTH" \
  -H "Content-Type: application/json" \
  -H "Accept: application/json" \
  -d '{
    "jql": "assignee = currentUser() and statusCategory != Done order by created desc",
    "maxResults": 200,
    "fields": ["key", "status", "summary", "timetracking"]
  }')

# Check if we got valid results
if ! echo "$ISSUES" | jq -e '.issues' > /dev/null 2>&1; then
  echo "Error fetching issues from Jira"
  echo "$ISSUES" | jq -r '.errorMessages[]? // .message // .' 2>/dev/null || echo "$ISSUES"
  exit 1
fi

# Check if there are any issues
ISSUE_COUNT=$(echo "$ISSUES" | jq '.issues | length')
if [[ "$ISSUE_COUNT" -eq 0 ]]; then
  echo "No open issues assigned to you."
  exit 0
fi

# Transform with jq and pipe to fzf
# Format: KEY <TAB> [status] <TAB> (estimate) <TAB> Summary (sorted by status, aligned with column)
SELECTION=$(echo "$ISSUES" | jq -r '.issues | sort_by(.fields.status.name)[] |
  "\(.key)\t[\(.fields.status.name)]\t(\(.fields.timetracking.originalEstimate // "-"))\t\(.fields.summary)"
' | column -t -s $'\t' | fzf --header="Select issue to open in browser")

# Check if user made a selection
if [[ -z "$SELECTION" ]]; then
  echo "No selection made, exiting."
  exit 0
fi

# Extract key (first field) and open in browser
KEY=$(echo "$SELECTION" | awk '{print $1}')
echo "Opening $KEY in browser..."
open "https://$JIRA_HOST/browse/$KEY"
